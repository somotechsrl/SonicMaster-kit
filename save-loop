#!/bin/bash
set -e
exec "${TSMA_PYTHON:-/usr/bin/python3}" - <<'PY'
import os,socket
from pathlib import Path
p=Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/f'jack-hooks-{os.getuid()}'/'tsma-looper.sock'
s=socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM)
s.sendto(b'save',str(p));s.close()
print('Salvataggio del loop richiesto al kit.')
PY
