#!/bin/bash
exec /usr/bin/python3 - <<'PY'
import os,socket
from pathlib import Path
p=Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/'sonicmaster-kit/looper.sock'
with socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM) as s:s.sendto(b'save',str(p))
print('Salvataggio del loop richiesto a SonicMaster-kit.')
PY
