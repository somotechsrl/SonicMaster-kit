-    if (frameHex != null) {
-      yield InboundMessage.classify(frameHex);
+  List<int>? pending;
+  await for (final chunk in wireMessages) {
+    for (final byte in chunk) {
+      if (byte >= 0xF8) continue; // Interleaved MIDI real-time events.
+      if (byte == 0xF0) { pending = [byte]; continue; }
+      if (pending == null) continue;
+      pending.add(byte);
+      if (pending.length > 65536) { pending = null; continue; }
+      if (byte != 0xF7) continue;
+      final packet = pending;
+      pending = null;
+      if (packet.length < 7) continue;
