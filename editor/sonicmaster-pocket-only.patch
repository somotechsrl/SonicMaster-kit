diff --git a/app/lib/protocol/tlv_state_dump.dart b/app/lib/protocol/tlv_state_dump.dart
new file mode 100644
index 0000000..a4b37e7
--- /dev/null
+++ b/app/lib/protocol/tlv_state_dump.dart
@@ -0,0 +1,85 @@
+import 'dart:typed_data';
+import '../model/command_library.dart';
+import '../model/decoded_preset_state.dart';
+import '../model/effect_library.dart';
+import '../model/modules.dart';
+
+/// Decode the device's tagged state records, independent of USB packet splits.
+/// Layout cross-checked with pocket-master-mcp (MIT) and live read-only dumps.
+class TlvStateDump {
+  TlvStateDump(this.body, this.tags);
+  final Uint8List body;
+  final Map<int, Uint8List> tags;
+
+  static TlvStateDump? decode(String frame) {
+    try {
+      final h=frame.toUpperCase();
+      if (!h.startsWith('8080F0') || !h.endsWith('F7') || h.length<30) return null;
+      final n=[for(var i=22;i<h.length-2;i+=2) int.parse(h.substring(i,i+2),radix:16)];
+      if(n.length.isOdd || n.any((b)=>b>15)) return null;
+      final b=Uint8List.fromList([for(var i=0;i<n.length;i+=2) n[i]*16+n[i+1]]);
+      if(b.length<6 || b[0]!=0x12 || b[1]!=0x41) return null;
+      final data=ByteData.sublistView(b);
+      final start=6+data.getUint16(4,Endian.little);
+      if(start>b.length) return null;
+      final tags=<int,Uint8List>{};
+      for(var at=start;at+4<=b.length;) {
+        final length=data.getUint16(at+2,Endian.little), end=at+4+length;
+        if(end>b.length) return null;
+        for(var p=at+4;p+4<=end;) {
+          final tag=data.getUint16(p,Endian.little), size=data.getUint16(p+2,Endian.little);
+          if(p+4+size>end) break;
+          tags[tag]=Uint8List.sublistView(b,p+4,p+4+size);p+=4+size;
+        }
+        at=end;
+      }
+      if(!tags.containsKey(0x3001)||!tags.containsKey(0x3002)||!tags.containsKey(0x3003)||!tags.containsKey(0x3004)) return null;
+      return TlvStateDump(b,tags);
+    } catch (_) {return null;}
+  }
+
+  int word(int tag,int fallback) {
+    final b=tags[tag];return b!=null&&b.length>=4?ByteData.sublistView(b).getUint32(0,Endian.little):fallback;
+  }
+
+  DecodedPresetState state(Modules modules) {
+    final mask=word(0x3001,0);
+    final chain=[for(final id in tags[0x3002]!.take(9)) if(modules.nameOf(id)!=null) modules.nameOf(id)!];
+    final data=ByteData.sublistView(body);
+    return DecodedPresetState(isCloneMode:(mask&512)!=0,presetVolume:word(0x2001,75),presetBpm:word(0x2002,120),
+      moduleStates:{for(var i=0;i<9;i++) if(modules.nameOf(i)!=null) modules.nameOf(i)!:(mask&(1<<i))!=0},chainOrder:chain,
+      footswitchFs1Mask:body.length>=474?data.getUint16(468,Endian.little):0,
+      footswitchFs2Mask:body.length>=474?data.getUint16(472,Endian.little):0);
+  }
+
+  Map<int,int> selected(CommandLibrary commands) {
+    final data=ByteData.sublistView(tags[0x3003]!);final result=<int,int>{0:1};
+    for(final entry in commands.effectTypes.entries) {
+      final id=entry.key;if(id*4+4>data.lengthInBytes) continue;
+      final code=data.getUint32(id*4,Endian.little);
+      for(final effect in entry.value.entries) {
+        var h=effect.value.toUpperCase();if(h.startsWith('8080')) h=h.substring(4);
+        h=h.substring(2,h.length-2);
+        final n=[for(var i=0;i<h.length;i+=2) int.parse(h.substring(i,i+2),radix:16)];
+        final b=Uint8List.fromList([for(var i=0;i<n.length;i+=2)n[i]*16+n[i+1]]);
+        if(b.length>=8 && ByteData.sublistView(b).getUint32(b.length-4,Endian.little)==code) {result[id]=effect.key;break;}
+      }
+    }
+    return result;
+  }
+
+  Map<int,Map<int,num>> parameters(EffectLibrary effects,Map<int,int> selected) {
+    final data=ByteData.sublistView(tags[0x3004]!);final result=<int,Map<int,num>>{};
+    for(final entry in selected.entries) {
+      final def=effects.byId(entry.value);if(def==null) continue;
+      final values=<int,num>{};
+      for(final param in def.params) {
+        final at=entry.key*32+param.algId*4;if(at+4>data.lengthInBytes) continue;
+        final value=data.getFloat32(at,Endian.little);if(!value.isFinite) continue;
+        values[param.algId]=(value-value.round()).abs()<1e-5?value.round():double.parse(value.toStringAsFixed(5));
+      }
+      result[entry.key]=values;
+    }
+    return result;
+  }
+}
