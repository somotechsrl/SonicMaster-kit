#!/bin/bash
# Collega Jamulus alla traccia di ingresso e al bus di uscita Ardour.
source "$(dirname -- "${BASH_SOURCE[0]}")/bridge-common.sh" "${1:-run}" || exit $?
export JAMULUS_CLIENT JAMULUS_DAW_CLIENT JAMULUS_INPUT_TRACK JAMULUS_OUTPUT_BUS JAMULUS_REMOVE_SYSTEM
for tool in python3 jack_connect jack_disconnect; do
    command -v "$tool" >/dev/null || { warn "$tool assente"; exit 1; }
done
python3 "$JACK_DRIVERS_DIR/jamulus-routing.py" --check || exit 1
case "$bridge_mode" in
    --check) exit 0 ;;
    --show) printf 'Jamulus: %s → %s / %s → %s\n' "$JAMULUS_CLIENT" "$JAMULUS_INPUT_TRACK" "$JAMULUS_OUTPUT_BUS" "$JAMULUS_CLIENT"; exit 0 ;;
esac
bridge_begin jamulus
JACK_DRIVERS_OWNER_PID=${JACK_DRIVERS_OWNER_PID:-$$} /usr/bin/python3 "$JACK_DRIVERS_DIR/jamulus-routing.py" 8>&- 9>&- &
bridge_children+=("$!")
bridge_wait
