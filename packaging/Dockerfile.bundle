FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends python3 python3-gi python3-dbus gir1.2-gtk-3.0 jackd2 sooperlooper zita-ajbridge xserver-xephyr openbox xauth x11-utils x11-xserver-utils wmctrl libnotify-bin xdg-user-dirs gcc g++ make libasound2-dev libjack-jackd2-dev libzita-resampler-dev libc6-dev linux-libc-dev libfontconfig1 libfreetype6 libgl1 libx11-6 libxext6 libxinerama1 libxcursor1 libxrandr2 libxrender1 libglib2.0-bin librsvg2-common ca-certificates curl file squashfs-tools patchelf rpm ffmpeg zstd
WORKDIR /src
